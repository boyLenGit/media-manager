# 应用配置示例,复制为 .env 后修改
APP_NAME=Media Manager
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# 认证 - 生产环境必须改! 用 `openssl rand -hex 32` 生成
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# 数据库
DATABASE_URL=sqlite:///./data/media_manager.db

# 数据存放根目录(数据库、缓存、封面等),容器里建议挂卷
DATA_DIR=./data

# 前端构建产物路径(生产模式由 FastAPI serve)
STATIC_DIR=../frontend/dist

# CORS,逗号分隔
CORS_ORIGINS=http://localhost:5173

# qBittorrent (留空表示未配置)
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Jellyfin (留空表示未配置)
JELLYFIN_URL=
JELLYFIN_API_KEY=
