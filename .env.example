# ===========================================================
# Media Manager 部署配置
#
# 复制本文件为 .env,然后修改下面的值。
# .env 不会被提交到 git。
# ===========================================================

# JWT 密钥 - 生产环境必改! 用 openssl rand -hex 32 生成 64 字符随机串
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# Token 有效期
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# 允许跨域的源,逗号分隔
# 群晖部署时改成 http://nas-ip:8000 或反代域名
CORS_ORIGINS=http://localhost:8000

# 容器对外暴露端口(如 8000 被占,改成 8090 等)
MEDIA_MANAGER_PORT=8000

# 镜像 tag
# - latest:跟随 master 分支自动更新
# - 1.2.3:固定到具体语义版本
# - sha-<commit>:固定到某次 commit
MEDIA_MANAGER_TAG=latest

# 时区
TZ=Asia/Shanghai
